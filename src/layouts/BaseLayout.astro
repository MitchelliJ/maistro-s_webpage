---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  active: 'home' | 'strategie' | 'power-ai' | 'ai-agents' | 'over-ons' | 'none';
  ctaLabel?: string;
  ctaHref?: string;
}

const { title, description, active, ctaLabel, ctaHref } = Astro.props;
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} — maistro’s</title>
  </head>
  <body>
    <div class="page">
      <Header active={active} ctaLabel={ctaLabel} ctaHref={ctaHref} />
      <slot />
      <Footer />
    </div>
    <script>
      const root = document.documentElement;
      root.classList.add('js');
      const els = Array.from(document.querySelectorAll('.rv, .rl, .bt'));
      const reveal = (el: Element) => el.classList.add('in');
      if (!('IntersectionObserver' in window)) {
        els.forEach(reveal);
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                reveal(entry.target);
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
        setTimeout(() => els.forEach(reveal), 2500);
      }
    </script>
  </body>
</html>
