---
import BaseLayout from '../layouts/BaseLayout.astro';

const cards = [
  {
    title: 'AI-scan',
    body: 'Samen om tafel. Je krijgt een concreet overzicht van kansen, gerangschikt op impact en haalbaarheid.',
  },
  {
    title: 'Roadmap',
    body: 'Wat eerst, wat later, wat nooit — met kosten en verwachte opbrengst per stap.',
  },
  {
    title: 'Sparringpartner',
    body: 'Een vast moment per maand voor directies die AI serieus nemen maar geen CTO hebben. Jij houdt overzicht, wij houden je scherp.',
  },
];
---

<BaseLayout
  title="Strategie & advies"
  description="Voor je investeert in AI, wil je weten waar het geld zit. AI-scan, roadmap en een vaste sparringpartner voor directies die AI serieus nemen."
  active="strategie"
>
  <div class="split-even">
    <div class="section section-tight" style="border-bottom: 0;">
      <div class="rv eyebrow">Strategie &amp; advies</div>
      <h1 class="rv hero-title" style="animation-delay: .06s;">Eerst weten.<br />Dan doen.</h1>
    </div>
    <div class="section section-tight" style="border-bottom: 0; display: flex; align-items: center;">
      <p class="rv" style="font-size: 19px; line-height: 1.55; margin: 0; animation-delay: .12s;">Voor je investeert in AI, wil je weten waar het geld zit. Wij kijken naar je bedrijf zoals een bouwer dat doet: welke processen zijn repetitief, waar zit de data, wat is realistisch met de tools die je al hebt.</p>
    </div>
  </div>

  <div class="section section-tight" style="border-bottom: 0;">
    <h2 class="rv section-title">Wat je krijgt</h2>
  </div>
  <div class="cols-3 section">
    {cards.map((card, i) => (
      <div class="rv" style={i ? `animation-delay: ${(i * 0.06).toFixed(2)}s;` : undefined}>
        <div style="width: 44px; height: 6px; background: var(--color-accent); margin-bottom: 18px;"></div>
        <h3 style="margin: 0 0 10px;">{card.title}</h3>
        <p style="font-size: 14.5px; line-height: 1.6; margin: 0;">{card.body}</p>
      </div>
    ))}
  </div>

  <div class="cta-banner">
    <div>
      <h2 class="rv section-title" style="margin-bottom: 16px; max-width: 24ch;">Eerste gesprek is gratis.</h2>
      <p class="rv lede" style="max-width: 56ch;">Een uur aan tafel. Geen verplichtingen, geen verkooppraatje.</p>
    </div>
    <a href="mailto:hallo@maistros.co?subject=Kennismaking" class="btn btn-primary" style="font-size: 16px; padding: 16px 20px;">Plan een kennismaking</a>
  </div>
</BaseLayout>
