---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina niet gevonden" description="Deze pagina bestaat niet. Onze agents wel." active="none">
  <div class="section" style="border-bottom: 0; max-width: 640px;">
    <div class="rv stat-404">404</div>
    <h1 class="rv hero-title" style="--h1-size: 2.375rem; --h1-measure: 20ch; line-height: 1.02; margin-bottom: 20px; animation-delay: .06s;">Deze pagina bestaat niet. Onze agents wel.</h1>
    <a href="/" class="btn btn-primary rv" style="font-size: 15px; padding: 13px 20px; animation-delay: .12s;">Terug naar home</a>
  </div>
</BaseLayout>
