---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    n: '1',
    title: 'AI-champions',
    body: 'Elke afdeling wijst één persoon aan. Niet per se de meest technische, wel de meest nieuwsgierige. Dit worden de AI-champions van jouw organisatie.',
  },
  {
    n: '2',
    title: 'Workshop',
    body: 'We leren de champions wat AI kan, wat het niet kan, en hoe je een goed use case herkent. Na afloop weet iedereen hoe ze AI kansen herkennen in het dagdagelijkse werk.',
  },
  {
    n: '3',
    title: 'Observatie & businesscase',
    body: 'We observeren het proces. We maken van te voren een business case: wat het kost, wat het oplevert, waar de winst zit. Soms is het antwoord: "niet doen".',
  },
  {
    n: '4',
    title: 'Bouwen',
    body: 'De beste agents worden gebouwd. Samen met jouw mensen, zodat we ook de details juist krijgen, en de kennis in jouw bedrijf blijft.',
  },
  {
    n: '5',
    title: 'Volgende ronde',
    body: 'De champions hebben nu een werkende agent gezien. Ze zien de volgende kansen zelf.',
  },
];
---

<BaseLayout
  title="AI-agents op maat"
  description="Jullie kennen het werk. Wij kennen AI. Samen bouwen we de agent — van AI-champions tot een werkende agent, gebouwd met je eigen mensen."
  active="ai-agents"
  ctaHref="mailto:hallo@maistros.co?subject=Kennismaking%20AI-agents%20op%20maat"
>
  <div class="section section-tight hero-agents">
    <div class="rv eyebrow">AI-agents op maat</div>
    <h1 class="rv hero-title" style="--h1-measure: 22ch; animation-delay: .06s;">Jullie kennen het werk. Wij kennen AI. Samen bouwen we de agent.</h1>
    <div class="hero-agents-row">
      <p class="rv lede" style="max-width: 60ch; margin: 0 0 28px; animation-delay: .12s;">De beste AI-toepassingen worden niet bedacht in een vergaderzaal. Ze komen van de mensen die elke dag tegen hetzelfde probleem aanlopen. Ons traject haalt die kennis naar boven en bouwt er iets van dat werkt. In weken, niet in maanden.</p>
      <a href="mailto:hallo@maistros.co?subject=Kennismaking%20AI-agents%20op%20maat" class="btn btn-primary rv" style="font-size: 15px; padding: 14px 20px; animation-delay: .18s;">Plan een kennismaking</a>
    </div>
  </div>

  <div class="section section-tight" style="border-bottom: 0;">
    <h2 class="rv section-title">Het traject</h2>
  </div>
  <div class="steps section" style="padding: 0; border-bottom: 1px solid var(--color-divider);">
    {steps.map((step, i) => (
      <div class="rv" style={`animation-delay: ${(i * 0.06).toFixed(2)}s;`}>
        <div class="step-marker"><span></span><span>Stap {step.n}</span></div>
        <h3 style="margin: 0;">{step.title}</h3>
        <p style="font-size: 14px; line-height: 1.6; margin: 0;">{step.body}</p>
      </div>
    ))}
  </div>

  <div class="section section-tight" style="border-bottom: 0;">
    <p class="rv pull-quote" style="margin: 0 auto; max-width: 34ch; text-align: center;">“Zo groeit AI in je bedrijf. Zodat je het ook zonder ons kan.”</p>
  </div>

  <div class="split-reverse" style="--side-w: 340px;">
    <div class="section section-tight" style="border-bottom: 0;">
      <h2 class="rv section-title" style="margin-bottom: 14px;">Voor wie</h2>
      <p class="rv" style="font-size: 17px; line-height: 1.65; margin: 0;">Dit werkt voor bedrijven van 25 tot 250 medewerkers waar:</p>
    </div>
    <div class="section section-tight" style="border-bottom: 0;">
      <div class="rows">
        <div class="rv" style="font-size: 17px; line-height: 1.65;">processen grotendeels in Microsoft draaien;</div>
        <div class="rv" style="font-size: 17px; line-height: 1.65; animation-delay: .06s;">de directie zelf achter AI staat (dit werkt niet als project van IT alleen);</div>
        <div class="rv" style="font-size: 17px; line-height: 1.65; animation-delay: .12s;">er ruimte is om mensen een paar dagen vrij te maken om mee te bouwen.</div>
      </div>
    </div>
  </div>

  <div class="cta-banner">
    <div>
      <h2 class="rv section-title" style="margin-bottom: 16px; max-width: 24ch;">Laten we beginnen.</h2>
      <p class="rv lede" style="max-width: 56ch;">Plan een kennismaking. We leren jouw bedrijf graag kennen!</p>
    </div>
    <a href="mailto:hallo@maistros.co?subject=Kennismaking%20AI-agents%20op%20maat" class="btn btn-primary" style="font-size: 16px; padding: 16px 20px;">Plan een kennismaking</a>
  </div>
</BaseLayout>

<style>
  .hero-agents {
    border-bottom: 1px solid var(--color-divider);
  }
  .hero-agents-row {
    display: block;
  }
  @media (max-width: 860px) {
    .hero-agents-row .btn {
      width: 100%;
    }
  }
</style>
